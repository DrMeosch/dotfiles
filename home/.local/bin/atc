#!/usr/bin/env bash
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}"
state="$config/atc-theme"
arg="${1:-toggle}"

current="$(cat "$state" 2>/dev/null || echo dark)"

if [[ "$arg" == toggle ]]; then
  [[ "$current" == dark ]] && theme=light || theme=dark
else
  theme="$arg"
fi

case "$theme" in
dark)
  alacritty_color=dracula_plus
  tmux_color=dark
  nvim_colorscheme=dracula
  btop_theme=DWM-Pink-Dark
  ;;
light)
  alacritty_color=github_light_colorblind
  tmux_color=light
  nvim_colorscheme=github_light_colorblind
  btop_theme=DWM-Pink-Light
  ;;
*)
  echo "Usage: atc [dark|light|toggle]" >&2
  exit 2
  ;;
esac

alacritty_dir="$config/alacritty"
tmux_dir="$HOME/.tmux"

# Update Alacritty's imported theme. Touch the main config to prompt reload.
cat "$alacritty_dir/themes/$alacritty_color.toml" >"$alacritty_dir/current-theme.toml"
touch "$alacritty_dir/alacritty.toml"

# Reload tmux's theme only if a tmux session is already running.
if tmux has-session 2>/dev/null; then
  cp "$tmux_dir/$tmux_color.conf" "$tmux_dir/current-theme.conf"
  tmux source-file "$tmux_dir/current-theme.conf"
fi

# Set btop's color_theme in place. btop.conf is btop's own mutable file, so only
# that one line is rewritten (atomically); a missing file is left for btop to create.
btop_conf="$config/btop/btop.conf"
if [[ -f "$btop_conf" ]]; then
  btop_conf="$(readlink -f "$btop_conf")"
  tmp="$(mktemp "$btop_conf.XXXXXX")"
  sed -E "s|^color_theme[[:space:]]*=.*|color_theme = \"$btop_theme\"|" "$btop_conf" >"$tmp"
  grep -q '^color_theme[[:space:]]*=' "$tmp" || printf 'color_theme = "%s"\n' "$btop_theme" >>"$tmp"
  chmod --reference="$btop_conf" "$tmp"
  mv "$tmp" "$btop_conf"
  # btop 1.3.1+ hot-reloads its config on SIGUSR2; older builds would be killed by
  # it, so signal only running btops whose binary reports a new enough version.
  while read -r pid; do
    ver="$("/proc/$pid/exe" --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1)" || true
    if [[ -n "$ver" && "$(printf '%s\n1.3.1\n' "$ver" | sort -V | head -n1)" == 1.3.1 ]]; then
      kill -USR2 "$pid" 2>/dev/null || true
    fi
  done < <(pgrep -u "$(id -u)" -x btop || true)
fi

# Switch every discoverable, listening Neovim instance.
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  while IFS= read -r -d '' sock; do
    nvim --server "$sock" \
      --remote-expr "execute('colorscheme $nvim_colorscheme')" \
      >/dev/null 2>&1 || true
  done < <(find "$XDG_RUNTIME_DIR" -type s -name 'nvim-*.sock' -print0 2>/dev/null)
fi

printf '%s\n' "$theme" >"$state"
echo "Theme: $theme"

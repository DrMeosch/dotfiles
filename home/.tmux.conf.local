# ~/.tmux.conf.local - overrides for the vendored gpakosz .tmux.conf.
# This is the file to edit; never edit ~/.tmux.conf itself.
# Full list of knobs: https://github.com/gpakosz/.tmux

# -- true color ---------------------------------------------------------------
# Alacritty + Neovim want 24-bit color.
tmux_conf_theme_24b_colour=true

# -- clipboard ----------------------------------------------------------------
# Copy selections to the OS clipboard. The base config already detects the right
# backend per platform: xsel/xclip on X11, clip.exe on WSL2, pbcopy on macOS.
tmux_conf_copy_to_os_clipboard=true

# -- behaviour ----------------------------------------------------------------
# New windows and panes open in the current pane's directory.
tmux_conf_new_window_retain_current_path=true
tmux_conf_new_pane_retain_current_path=true

# -- theme (rose-pine moon, to match Alacritty and Neovim) --------------------
# This vendored gpakosz config reads NAMED theme variables, not a numbered
# palette, so the rose-pine hexes are wired straight into the names it consumes.
# status bar
tmux_conf_theme_status_fg="#908caa"                 # subtle
tmux_conf_theme_status_bg="#2a273f"                 # surface
# inactive windows in the status line
tmux_conf_theme_window_status_fg="#6e6a86"          # muted
tmux_conf_theme_window_status_bg="#2a273f"          # surface
# the current window
tmux_conf_theme_window_status_current_fg="#232136"  # base
tmux_conf_theme_window_status_current_bg="#9ccfd8"  # foam (accent)
# messages / command prompt
tmux_conf_theme_message_fg="#232136"                # base
tmux_conf_theme_message_bg="#f6c177"                # gold
tmux_conf_theme_message_command_fg="#e0def4"        # text
tmux_conf_theme_message_command_bg="#393552"        # overlay
# pane borders
tmux_conf_theme_pane_border="#393552"               # overlay
tmux_conf_theme_pane_active_border="#9ccfd8"        # foam (accent)

# -- raw tmux overrides -------------------------------------------------------
# Anything below here is plain tmux config, applied verbatim.
set -g mouse on
# Tell tmux the outer terminal is truecolor-capable (Alacritty).
set -ga terminal-overrides ",alacritty:RGB,xterm-256color:RGB"
